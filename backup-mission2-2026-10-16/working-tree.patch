+    grid-template-rows: repeat(2,1fr);
+    gap: 16px
+}
+
+.news-card {
+    background: #fff;
+    border: 1px solid var(--line);
+    border-radius: var(--radius);
+    overflow: hidden;
+    display: grid;
+    grid-template-columns: 150px 1fr;
+    min-height: 180px;
+    transition: .2s
+}
+
+.news-card:hover,
+.shop-card:hover,
+.pro-card:hover {
+    transform: translateY(-3px);
+    box-shadow: var(--shadow)
+}
+
+.news-card.featured {
+    grid-row: 1/3;
+    display: block
+}
+
+.news-image {
+    min-height: 100%;
+    background: linear-gradient(135deg,#c89e19,#f2d66b);
+    display: grid;
+    place-items: center;
+    color: #ffffffde;
+    font-size: 40px
+}
+
+.featured .news-image {
+    height: 270px
+}
+
+.news-content {
+    padding: 20px
+}
+
+.news-content h3 {
+    font-size: 19px;
+    line-height: 1.35;
+    margin: 8px 0
+}
+
+.featured .news-content h3 {
+    font-size: 28px
+}
+
+.news-content p {
+    color: var(--muted);
+    font-size: 13px
+}
+
+.meta {
+    color: #85909c;
+    font-size: 12px
+}
+
+.category {
+    font-size: 11px;
+    text-transform: uppercase;
+    letter-spacing: .08em;
+    font-weight: 800;
+    color: #96720c
+}
+
+/* Actualités, commerces et annuaire */
+.shop-grid,
+.pro-grid {
+    display: grid;
+    grid-template-columns: repeat(3,1fr);
+    gap: 18px
+}
+
+.shop-card,
+.pro-card {
+    background: #fff;
+    border: 1px solid var(--line);
+    border-radius: var(--radius);
+    overflow: hidden;
+    transition: .2s
+}
+
+.shop-cover {
+    height: 170px;
+    background: linear-gradient(135deg,#e7d89d,#b88d14);
+    display: grid;
+    place-items: center;
+    color: #fff;
+    font-size: 42px
+}
+
+.shop-body,
+.pro-body {
+    padding: 20px
+}
+
+.shop-top {
+    display: flex;
+    justify-content: space-between;
+    gap: 10px
+}
+
+.shop-body h3,
+.pro-body h3 {
+    margin: 3px 0;
+    font-size: 19px
+}
+
+.shop-body p,
+.pro-body p {
+    color: var(--muted);
+    font-size: 13px;
+    margin: 9px 0
+}
+
+.badge {
+    display: inline-flex;
+    align-items: center;
+    gap: 5px;
+    color: var(--green);
+    background: #eaf6f1;
+    border-radius: 20px;
+    padding: 5px 8px;
+    font-size: 10px;
+    font-weight: 800;
+    white-space: nowrap
+}
+
+.card-footer {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    margin-top: 16px;
+    padding-top: 14px;
+    border-top: 1px solid var(--line);
+    font-size: 12px
+}
+
+.community-cta {
+    margin-top: 90px;
+    margin-bottom: 90px;
+    background: var(--navy);
+    color: #fff;
+    border-radius: 28px;
+    padding: 52px 58px;
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 30px
+}
+
+.community-cta h2 {
+    font-size: 38px;
+    margin: 9px 0
+}
+
+.community-cta p {
+    color: #c5d0db;
+    margin: 0
+}
+
+.eyebrow.light {
+    color: var(--gold2)
+}
+
+footer {
+    background: #0c1929;
+    color: #c7d1dc;
+    padding: 55px 0 20px
+}
+
+.footer-inner {
+    display: grid;
+    grid-template-columns: 1fr 1fr 1fr;
+    align-items: center
+}
+
+.light-brand {
+    color: #fff
+}
+
+.footer-inner>div {
+    display: flex;
+    justify-content: flex-end;
+    gap: 22px;
+    font-size: 13px
+}
+
+.footer-bottom {
+    margin-top: 35px;
+    border-top: 1px solid #ffffff1a;
+    padding-top: 18px;
+    font-size: 12px
+}
+
+.page-hero {
+    background: #fff;
+    padding: 70px 0 55px;
+    border-bottom: 1px solid var(--line)
+}
+
+.page-hero h1 {
+    font-size: clamp(38px,5vw,60px);
+    margin-bottom: 12px
+}
+
+.toolbar {
+    display: grid;
+    grid-template-columns: 1fr 220px 180px auto;
+    gap: 10px;
+    background: #fff;
+    padding: 14px;
+    border-radius: 17px;
+    border: 1px solid var(--line);
+    margin: 30px 0
+}
+
+.field {
+    display: flex;
+    align-items: center;
+    gap: 10px;
+    border: 1px solid var(--line);
+    background: #fafbf9;
+    border-radius: 11px;
+    padding: 0 13px
+}
+
+.field input,
+.field select {
+    width: 100%;
+    height: 46px;
+    border: 0;
+    background: transparent;
+    outline: 0
+}
+
+.result-row {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    margin: 20px 0
+}
+
+.link-button {
+    border: 0;
+    background: transparent;
+    color: var(--muted);
+    font-size: 13px
+}
+
+.pro-card {
+    padding: 20px;
+    display: flex;
+    flex-direction: column
+}
+
+.pro-head {
+    display: flex;
+    gap: 14px;
+    align-items: center
+}
+
+.avatar {
+    width: 58px;
+    height: 58px;
+    flex: none;
+    border-radius: 16px;
+    background: var(--soft);
+    color: #a37b0b;
+    display: grid;
+    place-items: center;
+    font-size: 21px
+}
+
+.pro-card .card-footer {
+    margin-top: auto
+}
+
+.empty {
+    grid-column: 1/-1;
+    padding: 60px;
+    text-align: center;
+    color: var(--muted)
+}
+
+/* Articles, fenêtres et formulaires */
+.article-layout {
+    display: grid;
+    grid-template-columns: minmax(0,760px) 1fr;
+    gap: 55px;
+    padding: 55px 0 90px
+}
+
+.article-main h1 {
+    font-size: clamp(36px,5vw,58px);
+    line-height: 1.1;
+    letter-spacing: -.04em
+}
+
+.article-lead {
+    font-size: 20px;
+    color: var(--muted)
+}
+
+.article-image {
+    height: 390px;
+    border-radius: 25px;
+    background: linear-gradient(135deg,var(--navy),#395873);
+    display: grid;
+    place-items: center;
+    color: #fff;
+    font-size: 70px;
+    margin: 28px 0
+}
+
+.article-copy {
+    font-family: Georgia,serif;
+    font-size: 18px;
+    line-height: 1.9
+}
+
+.aside-card {
+    position: sticky;
+    top: 95px;
+    background: #fff;
+    border: 1px solid var(--line);
+    padding: 22px;
+    border-radius: 18px
+}
+
+.modal {
+    position: fixed;
+    inset: 0;
+    background: #060f19a6;
+    z-index: 100;
+    display: none;
+    align-items: center;
+    justify-content: center;
+    padding: 20px
+}
+
+.modal.open {
+    display: flex
+}
+
+.modal-card {
+    background: #fff;
+    width: min(680px,100%);
+    max-height: 90vh;
+    overflow: auto;
+    border-radius: 24px;
+    padding: 28px;
+    position: relative
+}
+
+.modal-close {
+    position: absolute;
+    right: 18px;
+    top: 18px;
+    border: 0;
+    width: 38px;
+    height: 38px;
+    border-radius: 50%
+}
+
+.detail-cover {
+    height: 230px;
+    border-radius: 17px;
+    background: linear-gradient(135deg,#ddbd4c,#91700c);
+    display: grid;
+    place-items: center;
+    color: #fff;
+    font-size: 55px
+}
+
+.detail-actions {
+    display: flex;
+    gap: 10px;
+    margin-top: 20px
+}
+
+.notice {
+    background: #fff8dc;
+    border: 1px solid #ecd47a;
+    color: #745a05;
+    padding: 13px;
+    border-radius: 12px;
+    font-size: 12px
+}
+
+.feedback {
+    width: min(720px,calc(100% - 40px));
+    margin: 60px auto;
+    background: #fff;
+    padding: 32px;
+    border-radius: 24px;
+    border: 1px solid var(--line)
+}
+
+.form-grid {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 14px
+}
+
+.form-grid .full {
+    grid-column: 1/-1
+}
+
+.form-grid label {
+    font-size: 12px;
+    font-weight: 800;
+    display: block
+}
+
+.form-grid input,
+.form-grid textarea,
+.form-grid select {
+    width: 100%;
+    padding: 12px;
+    border: 1px solid var(--line);
+    border-radius: 10px
+}
+
+.form-grid textarea {
+    min-height: 130px
+}
+
+.filter-chips {
+    display: flex;
+    gap: 8px;
+    flex-wrap: wrap;
+    margin-bottom: 25px
+}
+
+.filter-chips button {
+    border: 1px solid var(--line);
+    background: #fff;
+    padding: 9px 14px;
+    border-radius: 20px
+}
+
+.filter-chips button.active {
+    background: var(--ink);
+    color: #fff
+}
+
+/* Adaptation tablette */
+@media(max-width:900px) {
+    .home-hero {
+        grid-template-columns: 1fr;
+        padding-top: 55px
+    }
+
+    .hero-panel {
+        display: none
+    }
+
+    .quick-links {
+        grid-template-columns: 1fr;
+        margin-top: 20px
+    }
+
+    .editorial-grid {
+        grid-template-columns: 1fr;
+        grid-template-rows: auto
+    }
+
+    .news-card.featured {
+        grid-row: auto
+    }
+
+    .shop-grid,
+    .pro-grid {
+        grid-template-columns: repeat(2,1fr)
+    }
+
+    .toolbar {
+        grid-template-columns: 1fr 1fr
+    }
+
+    .toolbar .field:first-child {
+        grid-column: 1/-1
+    }
+
+    .article-layout {
+        grid-template-columns: 1fr
+    }
+
+    .article-aside {
+        display: none
+    }
+
+    .footer-inner {
+        grid-template-columns: 1fr;
+        text-align: center;
+        gap: 18px
+    }
+
+    .footer-inner .brand {

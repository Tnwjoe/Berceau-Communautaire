+    }
+
+    .footer-inner>div {
+        justify-content: center
+    }
+
+    .main-nav {
+        display: none;
+        position: absolute;
+        left: 14px;
+        right: 14px;
+        top: 72px;
+        background: #fff;
+        border: 1px solid var(--line);

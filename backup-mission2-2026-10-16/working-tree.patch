+    }
+
+    .main-nav .nav-cta {
+        margin: 0
+    }
+
+    .nav-toggle {
+        display: block
+    }
+}
+
+/* Adaptation mobile */
+@media(max-width:600px) {
+    .wrap {
+        width: min(100% - 28px,1160px)
+    }
+
+    .site-header {
+        height: 68px;
+        padding-inline: 14px
+    }
+
+    .home-hero {
+        min-height: auto;
+        padding: 48px 18px
+    }
+
+    .home-hero h1 {
+        font-size: 43px
+    }
+

+/* Structure de l’administration */
+.admin-body {
+    background: #f2f4f1
+}
+
+.admin-sidebar {
+    position: fixed;
+    inset: 0 auto 0 0;
+    width: 260px;
+    background: #0d1d30;
+    color: #cbd5df;
+    padding: 24px 18px;
+    display: flex;
+    flex-direction: column;
+    z-index: 80
+}
+
+.admin-brand {
+    color: #fff;
+    margin: 0 6px 35px
+}
+
+.admin-sidebar nav {
+    display: flex;
+    flex-direction: column;
+    gap: 6px
+}
+
+.admin-sidebar nav button {
+    border: 0;
+    background: transparent;
+    color: #aebbc8;
+    text-align: left;
+    padding: 13px 14px;
+    border-radius: 10px;
+    font-size: 13px
+}
+
+.admin-sidebar nav button i {
+    width: 24px
+}
+
+.admin-sidebar nav button:hover,
+.admin-sidebar nav button.active {
+    background: #ffffff14;
+    color: #fff
+}
+
+.back-site {
+    margin-top: auto;
+    padding: 13px;
+    font-size: 13px;
+    border-top: 1px solid #ffffff17
+}
+
+.admin-main {
+    margin-left: 260px;
+    padding: 0 36px 60px;
+    max-width: 1500px
+}
+
+.admin-top {
+    height: 100px;
+    display: flex;
+    align-items: center;
+    gap: 20px
+}
+
+.admin-top h1 {
+    font-size: 27px;
+    margin: 0
+}
+
+.admin-top #admin-menu {
+    display: none;
+    border: 0;
+    background: #fff;
+    width: 42px;
+    height: 42px;
+    border-radius: 10px
+}
+
+.admin-avatar {
+    margin-left: auto;
+    width: 42px;
+    height: 42px;
+    border-radius: 50%;
+    background: var(--gold);
+    display: grid;
+    place-items: center;
+    color: #fff;
+    font-weight: 800
+}
+
+.admin-warning {
+    margin: 0 0 28px
+}
+
+/* Indicateurs et tableaux de gestion */
+.stat-grid {
+    display: grid;
+    grid-template-columns: repeat(5,1fr);
+    gap: 14px
+}
+
+.stat-card {
+    background: #fff;
+    border: 1px solid var(--line);
+    border-radius: 16px;
+    padding: 20px
+}
+
+.stat-card i {
+    color: var(--gold)
+}
+
+.stat-card strong {
+    display: block;
+    font-size: 30px;
+    margin-top: 14px
+}
+
+.stat-card span {
+    font-size: 12px;
+    color: var(--muted)
+}
+
+.admin-panel {
+    background: #fff;
+    border: 1px solid var(--line);
+    border-radius: 18px;
+    margin-top: 22px;
+    overflow: hidden
+}
+
+.panel-head {
+    padding: 18px 20px;
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    border-bottom: 1px solid var(--line)
+}
+
+.panel-head h2 {
+    font-size: 18px;
+    margin: 0
+}
+
+.admin-table {
+    width: 100%;
+    border-collapse: collapse
+}
+
+.admin-table th,
+.admin-table td {
+    text-align: left;
+    padding: 14px 20px;
+    border-bottom: 1px solid var(--line);
+    font-size: 12px
+}
+
+.admin-table th {
+    color: var(--muted);
+    font-size: 10px;
+    text-transform: uppercase;
+    letter-spacing: .08em
+}
+
+.row-actions {
+    display: flex;
+    gap: 6px
+}
+
+.icon-btn {
+    width: 34px;
+    height: 34px;
+    border: 1px solid var(--line);
+    background: #fff;
+    border-radius: 8px
+}
+
+.icon-btn.danger {
+    color: var(--red)
+}
+
+.admin-search {
+    border: 1px solid var(--line);
+    border-radius: 10px;
+    padding: 10px;
+    width: 240px
+}
+
+.switch {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px
+}
+
+.switch input {
+    accent-color: var(--green)
+}
+
+.admin-form h2 {
+    margin-top: 0
+}
+
+.admin-form .btn {
+    width: 100%
+}
+
+/* Adaptation responsive */
+@media(max-width:1050px) {
+    .stat-grid {
+        grid-template-columns: repeat(2,1fr)
+    }
+}
+
+@media(max-width:760px) {
+    .admin-sidebar {
+        transform: translateX(-100%);
+        transition: .2s
+    }
+
+    .admin-sidebar.open {
+        transform: none
+    }
+
+    .admin-main {
+        margin-left: 0;
+        padding: 0 14px 40px
+    }
+
+    .admin-top #admin-menu {
+        display: block
+    }
+
+    .stat-grid {
+        grid-template-columns: 1fr 1fr
+    }
+
+    .admin-panel {
+        overflow: auto
+    }
+
+    .admin-table {
+        min-width: 680px
+    }
+
+    .admin-warning {
+        font-size: 11px
+    }
+}
+
+@media(max-width:430px) {
+    .stat-grid {
+        grid-template-columns: 1fr
+    }
+}
